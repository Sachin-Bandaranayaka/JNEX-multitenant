// This is your Prisma schema file
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEAM_MEMBER
}

enum LeadStatus {
  PENDING
  CONFIRMED
  NO_ANSWER
  REJECTED
  DELETED
}

enum LeadReminderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
  RESCHEDULED
}

enum ShippingProvider {
  FARDA_EXPRESS
  TRANS_EXPRESS
  SL_POST
  ROYAL_EXPRESS
}

model Tenant {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Branding / Customization Fields ---
  businessName    String?
  logoUrl         String?
  backgroundColor String?
  cardColor       String?
  fontColor       String?

  // --- API KEY FIELDS ---
  fardaExpressClientId String?
  fardaExpressApiKey   String?
  transExpressApiKey   String?
  royalExpressApiKey   String?

  // --- NEW INVOICE FIELDS ---
  businessAddress String?
  businessPhone   String?
  invoicePrefix   String?

  // --- NEW: Order Prefixes for Shipping Providers ---
  transExpressOrderPrefix String? @default("JNEX")
  royalExpressOrderPrefix String? @default("JNEX")

  // --- NEW: Default Shipping Provider Field ---
  defaultShippingProvider ShippingProvider? @default(FARDA_EXPRESS)

  // --- NEW REFERRAL FIELDS ---
  referredById String?
  referredBy   Tenant?  @relation("TenantReferrals", fields: [referredById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  referrals    Tenant[] @relation("TenantReferrals")

  // --- Existing Relations ---
  users                       User[]
  products                    Product[]
  leads                       Lead[]
  orders                      Order[]
  stockAdjustments            StockAdjustment[]
  trackingUpdates             TrackingUpdate[]
  orderFinancialInfo          OrderFinancialInfo[]
  orderStatusHistory          OrderStatusHistory[]
  royalExpressTrackingDetails RoyalExpressTrackingDetail[]
  notifications               Notification[]
  leadReminders               LeadReminder[]

  // Store relations
  storePurchases StorePurchase[]
  printBatches   InvoicePrintBatch[]

  // Platform billing relations
  feeRates        TenantFeeRate[]
  deliveryCharges DeliveryCharge[]
  invoices        TenantInvoice[]
  invoicePayments TenantInvoicePayment[]
}

model User {
  id                     String              @id @default(uuid())
  email                  String              @unique
  name                   String?
  password               String
  role                   Role                @default(TEAM_MEMBER)
  permissions            String[]
  isActive               Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  orders                 Order[]
  leads                  Lead[]
  stockAdjustments       StockAdjustment[]
  printBatches           InvoicePrintBatch[]
  assignedLeadReminders  LeadReminder[]      @relation("LeadReminderAssignee")
  createdLeadReminders   LeadReminder[]      @relation("LeadReminderCreator")
  completedLeadReminders LeadReminder[]      @relation("LeadReminderCompleter")

  // Store relations
  cart           Cart?
  storePurchases StorePurchase[]

  // Platform billing relations
  submittedInvoicePayments TenantInvoicePayment[] @relation("InvoicePaymentSubmitter")

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([email])
  @@index([tenantId])
}

model Product {
  id            String   @id @default(uuid())
  code          String
  name          String
  description   String?
  price         Float
  stock         Int      @default(0)
  lowStockAlert Int      @default(10)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders           Order[]
  leads            Lead[]
  stockAdjustments StockAdjustment[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([code, tenantId])
  @@index([tenantId])
}

model Lead {
  id              String         @id @default(uuid())
  number          Int            @default(autoincrement())
  csvData         Json
  productCode     String
  product         Product        @relation(fields: [productCode, tenantId], references: [code, tenantId])
  status          LeadStatus     @default(PENDING)
  assignedTo      User?          @relation(fields: [userId], references: [id])
  userId          String?
  order           Order?
  reminders       LeadReminder[]
  callAttempts    Int            @default(0)
  notes           String?
  reminderDate    DateTime?
  reminderNote    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  statusChangedAt DateTime       @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([productCode])
  @@index([userId])
  @@index([tenantId])
  @@index([reminderDate])
  @@index([statusChangedAt])
}

model LeadReminder {
  id          String             @id @default(uuid())
  remindAt    DateTime
  note        String?
  status      LeadReminderStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  leadId         String
  lead           Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUserId String?
  assignedUser   User?   @relation("LeadReminderAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User    @relation("LeadReminderCreator", fields: [createdById], references: [id])
  completedById  String?
  completedBy    User?   @relation("LeadReminderCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  tenantId       String
  tenant         Tenant  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status, remindAt])
  @@index([assignedUserId, status, remindAt])
  @@index([leadId, status])
}

model Order {
  id                       String                      @id
  number                   Int                         @default(autoincrement())
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  status                   OrderStatus                 @default(PENDING)
  quantity                 Int                         @default(1)
  total                    Float                       @default(0)
  discount                 Float                       @default(0)
  customerName             String
  customerPhone            String
  customerSecondPhone      String?
  customerAddress          String
  customerCity             String                      @default("")
  shippingLocationProvider ShippingProvider?
  shippingDistrictId       Int?
  shippingDistrictName     String?
  shippingCityId           Int?
  shippingCityName         String?
  customerEmail            String?
  notes                    String?
  shippingProvider         ShippingProvider?
  trackingNumber           String?
  shippedAt                DateTime?
  deliveredAt              DateTime?
  trackingUpdates          TrackingUpdate[]
  financialInfo            OrderFinancialInfo?
  statusHistory            OrderStatusHistory[]
  notifications            Notification[]
  royalExpressTracking     RoyalExpressTrackingDetail?
  product                  Product                     @relation(fields: [productId], references: [id])
  productId                String
  lead                     Lead                        @relation(fields: [leadId], references: [id])
  leadId                   String                      @unique
  assignedTo               User                        @relation(fields: [userId], references: [id])
  userId                   String
  invoicePrinted           Boolean                     @default(false)
  lastTrackingCheckedAt    DateTime?
  trackingFailureCount     Int                         @default(0)
  trackingLastError        String?
  printBatchItems          InvoicePrintBatchItem[]
  deliveryCharge           DeliveryCharge?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([productId])
  @@index([leadId])
  @@index([userId])
  @@index([status])
  @@index([tenantId])
  @@index([status, lastTrackingCheckedAt])
}

model StockAdjustment {
  id            String   @id @default(uuid())
  product       Product  @relation(fields: [productId], references: [id])
  productId     String
  quantity      Int
  reason        String
  previousStock Int
  newStock      Int
  adjustedBy    User     @relation(fields: [userId], references: [id])
  userId        String
  createdAt     DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([tenantId])
}

model TrackingUpdate {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  status      String
  location    String?
  description String?
  timestamp   DateTime
  createdAt   DateTime @default(now())

  // Enhanced Royal Express fields
  provider          String?
  statusCode        String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  locationCode      String?
  locationName      String?
  coordinates       String? // JSON string for lat/lng
  isDelivered       Boolean   @default(false)
  isException       Boolean   @default(false)
  exceptionReason   String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([orderId])
  @@index([timestamp])
  @@index([tenantId])
  @@index([provider])
  @@index([statusCode])
  @@index([trackingNumber])
  @@index([isDelivered])
  @@index([isException])
}

model OrderFinancialInfo {
  id             String   @id @default(uuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  totalAmount    Float
  shippingCost   Float    @default(0)
  taxAmount      Float    @default(0)
  discountAmount Float    @default(0)
  paymentStatus  String
  paymentMethod  String?
  currency       String   @default("LKR")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId])
  @@index([paymentStatus])
}

model OrderStatusHistory {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          String
  statusCode      String
  description     String?
  location        String?
  timestamp       DateTime
  isCurrentStatus Boolean  @default(false)
  createdAt       DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId])
  @@index([statusCode])
  @@index([timestamp])
  @@index([isCurrentStatus])
  @@index([orderId, timestamp])
}

model RoyalExpressTrackingDetail {
  id                    String    @id @default(uuid())
  orderId               String    @unique
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingNumber        String
  currentStatus         String
  currentStatusCode     String
  estimatedDelivery     DateTime?
  actualDelivery        DateTime?
  lastLocationUpdate    String?
  lastLocationTimestamp DateTime?
  totalStatusUpdates    Int       @default(0)
  isDelivered           Boolean   @default(false)
  isException           Boolean   @default(false)
  exceptionDetails      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId])
  @@index([trackingNumber])
  @@index([currentStatusCode])
  @@index([isDelivered])
  @@index([isException])
  @@index([tenantId, isDelivered])
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  description String
  type        String // DELIVERY, RETURN, SYSTEM
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([read])
  @@index([createdAt])
}

model InvoicePrintBatch {
  id          String                  @id @default(cuid())
  createdAt   DateTime                @default(now())
  confirmedAt DateTime?
  tenantId    String
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User                    @relation(fields: [userId], references: [id])
  items       InvoicePrintBatchItem[]

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model InvoicePrintBatchItem {
  id       String            @id @default(cuid())
  position Int
  batchId  String
  batch    InvoicePrintBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderId  String
  order    Order             @relation(fields: [orderId], references: [id])

  @@unique([batchId, orderId])
  @@unique([batchId, position])
  @@index([orderId])
}

// ============================================
// STORE FEATURE MODELS (Super Admin Managed)
// ============================================

enum StorePurchaseStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// Products managed by Super Admin for the store
model StoreProduct {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  sku         String   @unique
  imageUrl    String? // S3 image URL
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems     CartItem[]
  purchaseItems StorePurchaseItem[]

  @@index([sku])
  @@index([isActive])
}

// Shopping cart for users
model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id             String       @id @default(uuid())
  cartId         String
  cart           Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  storeProductId String
  storeProduct   StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)
  quantity       Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([cartId, storeProductId])
  @@index([cartId])
  @@index([storeProductId])
}

// Purchase orders from users
model StorePurchase {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Bank transfer details
  bankReceiptNumber String
  whatsappNumber    String
  transferTime      DateTime

  // Order details
  totalAmount Float
  status      StorePurchaseStatus @default(PENDING)

  // Admin response
  confirmedAt     DateTime?
  confirmedBy     String?
  rejectionReason String?

  items     StorePurchaseItem[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model StorePurchaseItem {
  id              String        @id @default(uuid())
  purchaseId      String
  purchase        StorePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  storeProductId  String
  storeProduct    StoreProduct  @relation(fields: [storeProductId], references: [id])
  quantity        Int
  priceAtPurchase Float
  createdAt       DateTime      @default(now())

  @@index([purchaseId])
  @@index([storeProductId])
}

// ============================================
// PLATFORM BILLING MODELS (Super Admin Managed)
//
// The platform charges each tenant a fee per DELIVERED order. The fee is not
// fixed: it varies per tenant and changes over time. Three rules keep that safe:
//
//   1. Rates are effective-dated and never edited in place — changing a rate
//      closes the current TenantFeeRate row and opens a new one, so historic
//      charges always point at the rate that actually applied.
//   2. DeliveryCharge is an append-only ledger with one row per order
//      (@@unique on orderId), so retried crons and re-uploaded courier files
//      can never double-bill.
//   3. A tenant's balance is always derived by summing the ledger — it is
//      never stored as a mutable counter.
// ============================================

enum FeeModel {
  FLAT_PER_ORDER
  PERCENT_OF_ORDER
  TIERED_BY_VOLUME
}

enum ChargeStatus {
  ACCRUED // billable, not yet on an invoice
  INVOICED // locked onto an issued invoice
  PAID // invoice settled
  REVERSED // order was returned after delivery
  WAIVED // manually forgiven by a super admin
}

enum TenantInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum InvoicePaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// An effective-dated fee rate for one tenant. Never updated in place:
/// superseding a rate sets `effectiveTo` and inserts a new row.
model TenantFeeRate {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  feeModel FeeModel @default(FLAT_PER_ORDER)

  /// FLAT_PER_ORDER: the fee charged per delivered order.
  flatAmount  Decimal? @db.Decimal(12, 2)
  /// PERCENT_OF_ORDER: fraction of the order total, e.g. 0.0250 = 2.5%.
  percentRate Decimal? @db.Decimal(9, 6)
  /// TIERED_BY_VOLUME: [{ "upTo": 500, "amount": 50 }, { "upTo": null, "amount": 40 }]
  /// where `upTo` is the tenant's delivered-order count within the billing month.
  tiers       Json?

  /// Floor and ceiling applied after the model is evaluated.
  minFee   Decimal? @db.Decimal(12, 2)
  maxFee   Decimal? @db.Decimal(12, 2)
  currency String   @default("LKR")

  effectiveFrom DateTime
  /// null means "still in force". Only one open row per tenant at a time.
  effectiveTo   DateTime?
  note          String?
  createdByUserId String?
  createdAt     DateTime  @default(now())

  charges DeliveryCharge[]

  @@index([tenantId, effectiveFrom])
  @@index([tenantId, effectiveTo])
}

/// One immutable ledger row per delivered order. Written inside the same
/// transaction that marks the order DELIVERED.
model DeliveryCharge {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The idempotency key for the whole billing system.
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  rateId String
  rate   TenantFeeRate @relation(fields: [rateId], references: [id])

  /// Snapshots taken at accrual time so later edits can never rewrite history.
  feeModel    FeeModel
  orderTotal  Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  currency    String  @default("LKR")

  status      ChargeStatus @default(ACCRUED)
  deliveredAt DateTime
  /// Billing month in the platform timezone, e.g. "2026-08".
  periodKey   String
  /// 1-based position of this charge within the tenant's billing month, used
  /// to evaluate volume tiers.
  periodSequence Int

  invoiceId String?
  invoice   TenantInvoice? @relation("InvoiceCharges", fields: [invoiceId], references: [id])

  /// When a charge is reversed *after* it was already invoiced, the money is
  /// given back as a negative adjustment on a later invoice rather than by
  /// rewriting the issued one. This points at the invoice that carried the
  /// credit; null while the credit is still outstanding.
  creditInvoiceId String?
  creditInvoice   TenantInvoice? @relation("InvoiceCredits", fields: [creditInvoiceId], references: [id])

  reversedAt     DateTime?
  reversalReason String?
  waivedReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, periodKey, status])
  @@index([tenantId, deliveredAt])
  @@index([invoiceId])
  @@index([creditInvoiceId])
  @@index([status])
}

model TenantInvoice {
  id       String @id @default(uuid())
  number   Int    @default(autoincrement())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  periodKey   String
  periodStart DateTime
  periodEnd   DateTime

  status TenantInvoiceStatus @default(DRAFT)

  /// Totals are snapshotted at issue time; they do not recompute from the
  /// ledger afterwards.
  chargeCount Int     @default(0)
  subtotal    Decimal @db.Decimal(14, 2)
  adjustments Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)
  currency    String  @default("LKR")

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?
  voidedAt DateTime?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges  DeliveryCharge[]       @relation("InvoiceCharges")
  credits  DeliveryCharge[]       @relation("InvoiceCredits")
  payments TenantInvoicePayment[]

  @@unique([tenantId, periodKey])
  @@index([tenantId, status])
  @@index([status])
}

/// Bank-transfer settlement, mirroring the StorePurchase flow: the tenant
/// submits transfer details, a super admin confirms or rejects.
model TenantInvoicePayment {
  id        String        @id @default(uuid())
  invoiceId String
  invoice   TenantInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  submittedByUserId String
  submittedBy       User   @relation("InvoicePaymentSubmitter", fields: [submittedByUserId], references: [id])

  bankReceiptNumber String
  whatsappNumber    String
  transferTime      DateTime
  amount            Decimal  @db.Decimal(14, 2)

  status          InvoicePaymentStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([tenantId, status])
  @@index([status])
}
