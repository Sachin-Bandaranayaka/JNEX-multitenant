// This is your Prisma schema file
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEAM_MEMBER
}

enum ImpersonationMode {
  READ_ONLY
}

enum AuthCodePurpose {
  LOGIN
  PASSWORD_RESET
}

enum LeadStatus {
  PENDING
  CONFIRMED
  NO_ANSWER
  REJECTED
  DELETED
}

enum LeadReminderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
  RESCHEDULED
}

enum ShippingProvider {
  FARDA_EXPRESS
  TRANS_EXPRESS
  SL_POST
  ROYAL_EXPRESS
}

model Tenant {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Branding / Customization Fields ---
  businessName    String?
  logoUrl         String?
  backgroundColor String?
  cardColor       String?
  fontColor       String?

  // --- API KEY FIELDS ---
  fardaExpressClientId String?
  fardaExpressApiKey   String?
  transExpressApiKey   String?
  royalExpressApiKey   String?

  // --- NEW INVOICE FIELDS ---
  businessAddress String?
  businessPhone   String?
  invoicePrefix   String?

  // --- NEW: Order Prefixes for Shipping Providers ---
  transExpressOrderPrefix String? @default("JNEX")
  royalExpressOrderPrefix String? @default("JNEX")

  // --- NEW: Default Shipping Provider Field ---
  defaultShippingProvider ShippingProvider? @default(FARDA_EXPRESS)

  // --- NEW REFERRAL FIELDS ---
  referredById String?
  referredBy   Tenant?  @relation("TenantReferrals", fields: [referredById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  referrals    Tenant[] @relation("TenantReferrals")

  // --- Existing Relations ---
  users                       User[]
  products                    Product[]
  leads                       Lead[]
  orders                      Order[]
  stockAdjustments            StockAdjustment[]
  trackingUpdates             TrackingUpdate[]
  orderFinancialInfo          OrderFinancialInfo[]
  orderStatusHistory          OrderStatusHistory[]
  royalExpressTrackingDetails RoyalExpressTrackingDetail[]
  notifications               Notification[]
  leadReminders               LeadReminder[]

  // Store relations
  storePurchases StorePurchase[]
  printBatches   InvoicePrintBatch[]

  // --- Prepaid credit policy ---
  // POSTPAID tenants are billed by monthly invoice exactly as before; PREPAID
  // tenants must hold credit before a shipment can leave. New tenants stay
  // POSTPAID until a super admin deliberately moves them over.
  billingMode          BillingMode @default(POSTPAID)
  /// Overdraft allowed, in credits. 0 means "no credit, no shipping".
  creditLimitCredits   Decimal     @default(0) @db.Decimal(14, 4)
  /// Available balance below which shipping is refused. Defaults to 0.
  minimumShipCredits   Decimal?    @db.Decimal(14, 4)
  /// Available balance below which the tenant is nudged to top up.
  lowBalanceCredits    Decimal?    @db.Decimal(14, 4)
  /// Set when the low-balance notice was last sent, so it is not repeated daily.
  lowBalanceNotifiedAt DateTime?

  // Platform billing relations
  feeRates        TenantFeeRate[]
  deliveryCharges DeliveryCharge[]
  invoices        TenantInvoice[]
  invoicePayments TenantInvoicePayment[]

  // Prepaid credit relations
  creditPrices       CreditPrice[]
  creditTransactions CreditTransaction[]
  creditTopUps       CreditTopUp[]

  impersonationSessions ImpersonationSession[]
  auditEvents           AuditEvent[]
}

model User {
  id                     String              @id @default(uuid())
  email                  String              @unique
  name                   String?
  password               String
  /// Set whenever the password changes. Sessions minted before this moment
  /// are rejected by the session-status poll, so a password reset kicks out
  /// anyone still holding a JWT issued with the old credentials.
  passwordChangedAt      DateTime?
  role                   Role                @default(TEAM_MEMBER)
  permissions            String[]
  isActive               Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  orders                 Order[]
  leads                  Lead[]
  stockAdjustments       StockAdjustment[]
  printBatches           InvoicePrintBatch[]
  assignedLeadReminders  LeadReminder[]      @relation("LeadReminderAssignee")
  createdLeadReminders   LeadReminder[]      @relation("LeadReminderCreator")
  completedLeadReminders LeadReminder[]      @relation("LeadReminderCompleter")

  // Store relations
  cart           Cart?
  storePurchases StorePurchase[]

  // Platform billing relations
  submittedInvoicePayments TenantInvoicePayment[] @relation("InvoicePaymentSubmitter")
  submittedCreditTopUps    CreditTopUp[]          @relation("CreditTopUpSubmitter")

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  impersonationSessionsStarted  ImpersonationSession[] @relation("ImpersonationActor")
  impersonationSessionsTargeted ImpersonationSession[] @relation("ImpersonationTarget")
  auditEvents                   AuditEvent[]           @relation("AuditActor")

  @@index([email])
  @@index([tenantId])
}

/// A short-lived, read-only custody session. The actor is always a real
/// SUPER_ADMIN and the target is always an active tenant ADMIN.
model ImpersonationSession {
  id           String            @id @default(uuid())
  actorId      String
  actor        User              @relation("ImpersonationActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUserId String
  targetUser   User              @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reason       String
  mode         ImpersonationMode @default(READ_ONLY)
  startedAt    DateTime          @default(now())
  expiresAt    DateTime
  endedAt      DateTime?
  endReason    String?
  ipAddress    String?
  userAgent    String?
  auditEvents  AuditEvent[]

  @@index([actorId, startedAt])
  @@index([tenantId, startedAt])
  @@index([expiresAt, endedAt])
}

/// Append-only security and administration history. Application code must
/// never update or delete these rows.
model AuditEvent {
  id                     String                @id @default(uuid())
  actorId                String
  actor                  User                  @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  impersonationSessionId String?
  impersonationSession   ImpersonationSession? @relation(fields: [impersonationSessionId], references: [id], onDelete: SetNull)
  tenantId               String?
  tenant                 Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action                 String
  entityType             String?
  entityId               String?
  metadata               Json?
  ipAddress              String?
  userAgent              String?
  createdAt              DateTime              @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([tenantId, createdAt])
  @@index([impersonationSessionId, createdAt])
  @@index([action, createdAt])
}

model Product {
  id            String   @id @default(uuid())
  code          String
  name          String
  description   String?
  price         Float
  stock         Int      @default(0)
  lowStockAlert Int      @default(10)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders           Order[]
  leads            Lead[]
  stockAdjustments StockAdjustment[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([code, tenantId])
  @@index([tenantId])
}

model Lead {
  id              String         @id @default(uuid())
  number          Int            @default(autoincrement())
  csvData         Json
  productCode     String
  product         Product        @relation(fields: [productCode, tenantId], references: [code, tenantId])
  status          LeadStatus     @default(PENDING)
  assignedTo      User?          @relation(fields: [userId], references: [id])
  userId          String?
  order           Order?
  reminders       LeadReminder[]
  callAttempts    Int            @default(0)
  notes           String?
  reminderDate    DateTime?
  reminderNote    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  statusChangedAt DateTime       @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([productCode])
  @@index([userId])
  @@index([tenantId])
  @@index([reminderDate])
  @@index([statusChangedAt])
}

model LeadReminder {
  id          String             @id @default(uuid())
  remindAt    DateTime
  note        String?
  status      LeadReminderStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  leadId         String
  lead           Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUserId String?
  assignedUser   User?   @relation("LeadReminderAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User    @relation("LeadReminderCreator", fields: [createdById], references: [id])
  completedById  String?
  completedBy    User?   @relation("LeadReminderCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  tenantId       String
  tenant         Tenant  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status, remindAt])
  @@index([assignedUserId, status, remindAt])
  @@index([leadId, status])
}

model Order {
  id                       String                      @id
  number                   Int                         @default(autoincrement())
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  status                   OrderStatus                 @default(PENDING)
  quantity                 Int                         @default(1)
  total                    Float                       @default(0)
  discount                 Float                       @default(0)
  customerName             String
  customerPhone            String
  customerSecondPhone      String?
  customerAddress          String
  customerCity             String                      @default("")
  shippingLocationProvider ShippingProvider?
  shippingDistrictId       Int?
  shippingDistrictName     String?
  shippingCityId           Int?
  shippingCityName         String?
  customerEmail            String?
  notes                    String?
  shippingProvider         ShippingProvider?
  trackingNumber           String?
  shippedAt                DateTime?
  deliveredAt              DateTime?
  trackingUpdates          TrackingUpdate[]
  financialInfo            OrderFinancialInfo?
  statusHistory            OrderStatusHistory[]
  notifications            Notification[]
  royalExpressTracking     RoyalExpressTrackingDetail?
  product                  Product                     @relation(fields: [productId], references: [id])
  productId                String
  lead                     Lead                        @relation(fields: [leadId], references: [id])
  leadId                   String                      @unique
  assignedTo               User                        @relation(fields: [userId], references: [id])
  userId                   String
  invoicePrinted           Boolean                     @default(false)
  lastTrackingCheckedAt    DateTime?
  trackingFailureCount     Int                         @default(0)
  trackingLastError        String?
  printBatchItems          InvoicePrintBatchItem[]
  deliveryCharge           DeliveryCharge?
  creditTransactions       CreditTransaction[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([productId])
  @@index([leadId])
  @@index([userId])
  @@index([status])
  @@index([tenantId])
  @@index([status, lastTrackingCheckedAt])
}

model StockAdjustment {
  id            String   @id @default(uuid())
  product       Product  @relation(fields: [productId], references: [id])
  productId     String
  quantity      Int
  reason        String
  previousStock Int
  newStock      Int
  adjustedBy    User     @relation(fields: [userId], references: [id])
  userId        String
  createdAt     DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([tenantId])
}

model TrackingUpdate {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  status      String
  location    String?
  description String?
  timestamp   DateTime
  createdAt   DateTime @default(now())

  // Enhanced Royal Express fields
  provider          String?
  statusCode        String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  locationCode      String?
  locationName      String?
  coordinates       String? // JSON string for lat/lng
  isDelivered       Boolean   @default(false)
  isException       Boolean   @default(false)
  exceptionReason   String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([orderId])
  @@index([timestamp])
  @@index([tenantId])
  @@index([provider])
  @@index([statusCode])
  @@index([trackingNumber])
  @@index([isDelivered])
  @@index([isException])
}

model OrderFinancialInfo {
  id             String   @id @default(uuid())
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  totalAmount    Float
  shippingCost   Float    @default(0)
  taxAmount      Float    @default(0)
  discountAmount Float    @default(0)
  paymentStatus  String
  paymentMethod  String?
  currency       String   @default("LKR")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId])
  @@index([paymentStatus])
}

model OrderStatusHistory {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          String
  statusCode      String
  description     String?
  location        String?
  timestamp       DateTime
  isCurrentStatus Boolean  @default(false)
  createdAt       DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId])
  @@index([statusCode])
  @@index([timestamp])
  @@index([isCurrentStatus])
  @@index([orderId, timestamp])
}

model RoyalExpressTrackingDetail {
  id                    String    @id @default(uuid())
  orderId               String    @unique
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingNumber        String
  currentStatus         String
  currentStatusCode     String
  estimatedDelivery     DateTime?
  actualDelivery        DateTime?
  lastLocationUpdate    String?
  lastLocationTimestamp DateTime?
  totalStatusUpdates    Int       @default(0)
  isDelivered           Boolean   @default(false)
  isException           Boolean   @default(false)
  exceptionDetails      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tenantId])
  @@index([trackingNumber])
  @@index([currentStatusCode])
  @@index([isDelivered])
  @@index([isException])
  @@index([tenantId, isDelivered])
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  description String
  type        String // DELIVERY, RETURN, SYSTEM
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([read])
  @@index([createdAt])
}

model InvoicePrintBatch {
  id          String                  @id @default(cuid())
  createdAt   DateTime                @default(now())
  confirmedAt DateTime?
  tenantId    String
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User                    @relation(fields: [userId], references: [id])
  items       InvoicePrintBatchItem[]

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model InvoicePrintBatchItem {
  id       String            @id @default(cuid())
  position Int
  batchId  String
  batch    InvoicePrintBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderId  String
  order    Order             @relation(fields: [orderId], references: [id])

  @@unique([batchId, orderId])
  @@unique([batchId, position])
  @@index([orderId])
}

// ============================================
// STORE FEATURE MODELS (Super Admin Managed)
// ============================================

enum StorePurchaseStatus {
  PENDING
  CONFIRMED
  REJECTED
}

// Products managed by Super Admin for the store
model StoreProduct {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  sku         String   @unique
  imageUrl    String? // S3 image URL
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems     CartItem[]
  purchaseItems StorePurchaseItem[]

  @@index([sku])
  @@index([isActive])
}

// Shopping cart for users
model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id             String       @id @default(uuid())
  cartId         String
  cart           Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  storeProductId String
  storeProduct   StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)
  quantity       Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([cartId, storeProductId])
  @@index([cartId])
  @@index([storeProductId])
}

// Purchase orders from users
model StorePurchase {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Bank transfer details
  bankReceiptNumber String
  whatsappNumber    String
  transferTime      DateTime

  // Order details
  totalAmount Float
  status      StorePurchaseStatus @default(PENDING)

  // Admin response
  confirmedAt     DateTime?
  confirmedBy     String?
  rejectionReason String?

  items     StorePurchaseItem[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model StorePurchaseItem {
  id              String        @id @default(uuid())
  purchaseId      String
  purchase        StorePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  storeProductId  String
  storeProduct    StoreProduct  @relation(fields: [storeProductId], references: [id])
  quantity        Int
  priceAtPurchase Float
  createdAt       DateTime      @default(now())

  @@index([purchaseId])
  @@index([storeProductId])
}

// ============================================
// PLATFORM BILLING MODELS (Super Admin Managed)
//
// The platform charges each tenant a fee per DELIVERED order. The fee is not
// fixed: it varies per tenant and changes over time. Three rules keep that safe:
//
//   1. Rates are effective-dated and never edited in place — changing a rate
//      closes the current TenantFeeRate row and opens a new one, so historic
//      charges always point at the rate that actually applied.
//   2. DeliveryCharge is an append-only ledger with one row per order
//      (@@unique on orderId), so retried crons and re-uploaded courier files
//      can never double-bill.
//   3. A tenant's balance is always derived by summing the ledger — it is
//      never stored as a mutable counter.
// ============================================

enum FeeModel {
  FLAT_PER_ORDER
  PERCENT_OF_ORDER
  TIERED_BY_VOLUME
}

enum ChargeStatus {
  ACCRUED // billable, not yet on an invoice
  INVOICED // locked onto an issued invoice
  PAID // invoice settled
  REVERSED // order was returned after delivery
  WAIVED // manually forgiven by a super admin
}

enum TenantInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum InvoicePaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// An effective-dated fee rate for one tenant. Never updated in place:
/// superseding a rate sets `effectiveTo` and inserts a new row.
model TenantFeeRate {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  feeModel FeeModel @default(FLAT_PER_ORDER)

  /// FLAT_PER_ORDER: the fee charged per delivered order.
  flatAmount  Decimal? @db.Decimal(12, 2)
  /// PERCENT_OF_ORDER: fraction of the order total, e.g. 0.0250 = 2.5%.
  percentRate Decimal? @db.Decimal(9, 6)
  /// TIERED_BY_VOLUME: [{ "upTo": 500, "amount": 50 }, { "upTo": null, "amount": 40 }]
  /// where `upTo` is the tenant's delivered-order count within the billing month.
  tiers       Json?

  /// Floor and ceiling applied after the model is evaluated.
  minFee   Decimal? @db.Decimal(12, 2)
  maxFee   Decimal? @db.Decimal(12, 2)
  currency String   @default("LKR")

  effectiveFrom   DateTime
  /// null means "still in force". Only one open row per tenant at a time.
  effectiveTo     DateTime?
  note            String?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  charges DeliveryCharge[]

  @@index([tenantId, effectiveFrom])
  @@index([tenantId, effectiveTo])
}

/// One immutable ledger row per delivered order. Written inside the same
/// transaction that marks the order DELIVERED.
model DeliveryCharge {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The idempotency key for the whole billing system.
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  rateId String
  rate   TenantFeeRate @relation(fields: [rateId], references: [id])

  /// Snapshots taken at accrual time so later edits can never rewrite history.
  feeModel   FeeModel
  orderTotal Decimal  @db.Decimal(12, 2)
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("LKR")

  status         ChargeStatus @default(ACCRUED)
  deliveredAt    DateTime
  /// Billing month in the platform timezone, e.g. "2026-08".
  periodKey      String
  /// 1-based position of this charge within the tenant's billing month, used
  /// to evaluate volume tiers.
  periodSequence Int

  invoiceId String?
  invoice   TenantInvoice? @relation("InvoiceCharges", fields: [invoiceId], references: [id])

  /// When a charge is reversed *after* it was already invoiced, the money is
  /// given back as a negative adjustment on a later invoice rather than by
  /// rewriting the issued one. This points at the invoice that carried the
  /// credit; null while the credit is still outstanding.
  creditInvoiceId String?
  creditInvoice   TenantInvoice? @relation("InvoiceCredits", fields: [creditInvoiceId], references: [id])

  reversedAt     DateTime?
  reversalReason String?
  waivedReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /// Wallet movements this charge produced (PREPAID tenants only).
  creditTransactions CreditTransaction[]

  @@index([tenantId, periodKey, status])
  @@index([tenantId, deliveredAt])
  @@index([invoiceId])
  @@index([creditInvoiceId])
  @@index([status])
}

model TenantInvoice {
  id       String @id @default(uuid())
  number   Int    @default(autoincrement())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  periodKey   String
  periodStart DateTime
  periodEnd   DateTime

  status TenantInvoiceStatus @default(DRAFT)

  /// Totals are snapshotted at issue time; they do not recompute from the
  /// ledger afterwards.
  chargeCount Int     @default(0)
  subtotal    Decimal @db.Decimal(14, 2)
  adjustments Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)
  currency    String  @default("LKR")

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?
  voidedAt DateTime?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges  DeliveryCharge[]       @relation("InvoiceCharges")
  credits  DeliveryCharge[]       @relation("InvoiceCredits")
  payments TenantInvoicePayment[]

  @@unique([tenantId, periodKey])
  @@index([tenantId, status])
  @@index([status])
}

/// Bank-transfer settlement, mirroring the StorePurchase flow: the tenant
/// submits transfer details, a super admin confirms or rejects.
model TenantInvoicePayment {
  id        String        @id @default(uuid())
  invoiceId String
  invoice   TenantInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  submittedByUserId String
  submittedBy       User   @relation("InvoicePaymentSubmitter", fields: [submittedByUserId], references: [id])

  bankReceiptNumber String
  whatsappNumber    String
  transferTime      DateTime
  amount            Decimal  @db.Decimal(14, 2)

  status          InvoicePaymentStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([tenantId, status])
  @@index([status])
}

// ============================================
// PREPAID CREDITS
//
// Design notes worth keeping next to the models:
//   1. The wallet is denominated in CREDITS, not money. A credit's price in
//      LKR is set by a super admin and is effective-dated, so raising the
//      price never retroactively devalues credit a tenant already paid for.
//   2. Credits consumed by an order = fee (TenantFeeRate) / credit price. With
//      a LKR 75 flat fee and a LKR 75 credit that is exactly 1.0000 credit per
//      delivered order; percentage and tiered pricing scale from the same rule.
//   3. Credit is HELD when an order ships and CAPTURED when it delivers, so a
//      tenant can never owe more than one order's fee at any instant. That, not
//      a monthly minimum purchase, is what removes the non-payment risk.
//   4. The ledger is append-only and every row carries an idempotencyKey, so a
//      retried transition or a re-uploaded courier file can never double-spend.
//   5. A tenant's balance is derived from the ledger under an advisory lock and
//      stamped onto the row as `creditsAfter`; the money columns are reporting
//      only and are never summed to produce a balance.
// ============================================

enum BillingMode {
  /// Billed by monthly invoice after delivery. The original behaviour.
  POSTPAID
  /// Must hold credit before shipping; fees are taken from the wallet.
  PREPAID
}

enum CreditTxType {
  /// A confirmed bank transfer. Positive.
  TOPUP
  /// Reserved when an order ships. Negative.
  HOLD
  /// A hold given back — the order was returned, cancelled, or the hold was
  /// superseded by the capture at delivery. Positive.
  RELEASE
  /// The real fee taken when an order delivers. Negative.
  CAPTURE
  /// A delivered order that was later returned. Positive.
  REFUND
  /// Manual super admin correction, in either direction. Always has a reason.
  ADJUSTMENT
}

enum TopUpStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// An effective-dated price for one credit. Never updated in place: superseding
/// sets `effectiveTo` and inserts a new row, so every historic transaction can
/// still be valued at the terms that produced it.
///
/// A row with a null `tenantId` is the platform-wide default; a row with a
/// tenantId overrides it for that tenant only.
model CreditPrice {
  id       String  @id @default(uuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// What one credit costs, e.g. 75.00.
  unitPrice Decimal @db.Decimal(12, 2)
  currency  String  @default("LKR")

  /// Smallest top-up a tenant may submit, in credits.
  minimumPurchaseCredits Decimal @default(100) @db.Decimal(14, 4)

  effectiveFrom   DateTime
  /// null means "still in force". Only one open row per scope at a time.
  effectiveTo     DateTime?
  note            String?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  transactions CreditTransaction[]
  topUps       CreditTopUp[]

  @@index([tenantId, effectiveFrom])
  @@index([tenantId, effectiveTo])
}

/// One immutable row per wallet movement.
model CreditTransaction {
  id  String @id @default(uuid())
  /// Monotonic per-tenant ordering. Rows are only ever written while holding
  /// the tenant's advisory lock, so the highest seq is always the newest row —
  /// which is how the running balance is read back in one indexed lookup.
  seq Int    @default(autoincrement())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type CreditTxType

  /// Signed, in credits. Summing this column for a tenant gives the balance.
  credits      Decimal @db.Decimal(14, 4)
  /// Running balance after this row, written under the tenant advisory lock so
  /// the balance can be read from one indexed row instead of a full sum.
  creditsAfter Decimal @db.Decimal(14, 4)

  /// Money value at the price in force when the row was written. Reporting and
  /// reconciliation only — never summed to produce a balance.
  amount    Decimal @db.Decimal(14, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  currency  String  @default("LKR")

  creditPriceId String?
  creditPrice   CreditPrice? @relation(fields: [creditPriceId], references: [id])

  /// The idempotency key for the whole wallet, e.g. "hold:<orderId>",
  /// "release:<orderId>", "capture:<orderId>", "topup:<topUpId>".
  idempotencyKey String @unique

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  chargeId String?
  charge   DeliveryCharge? @relation(fields: [chargeId], references: [id])

  topUpId String?
  topUp   CreditTopUp? @relation(fields: [topUpId], references: [id])

  reason          String?
  createdByUserId String?
  /// Reserved so use-it-or-lose-it credit can be added later without a
  /// migration. Nothing reads it yet.
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId, seq])
  @@index([tenantId, createdAt])
  @@index([tenantId, type])
  @@index([orderId])
  @@index([chargeId])
  @@index([topUpId])
}

/// A bank-transfer credit purchase, mirroring TenantInvoicePayment: the tenant
/// submits transfer details, a super admin confirms or rejects. Credit only
/// reaches the wallet on confirmation.
model CreditTopUp {
  id       String @id @default(uuid())
  number   Int    @default(autoincrement())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  submittedByUserId String
  submittedBy       User   @relation("CreditTopUpSubmitter", fields: [submittedByUserId], references: [id])

  /// What the tenant asked to buy, and the price they were quoted.
  credits       Decimal      @db.Decimal(14, 4)
  unitPrice     Decimal      @db.Decimal(12, 2)
  amount        Decimal      @db.Decimal(14, 2)
  currency      String       @default("LKR")
  creditPriceId String?
  creditPrice   CreditPrice? @relation(fields: [creditPriceId], references: [id])

  bankReceiptNumber String
  whatsappNumber    String
  transferTime      DateTime

  status          TopUpStatus @default(PENDING)
  /// What was actually credited. Lets a super admin confirm a short transfer
  /// for less than was requested instead of rejecting it outright.
  creditedCredits Decimal?    @db.Decimal(14, 4)
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNote      String?
  rejectionReason String?

  transactions CreditTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([status, createdAt])
}

/// One-time email codes for passwordless sign-in and password resets.
///
/// Keyed by email rather than by a User relation on purpose: a code is issued
/// (or silently not issued) before we admit whether an account exists, and the
/// rows outlive the account they belong to only until they expire.
model AuthCode {
  id         String          @id @default(uuid())
  email      String
  purpose    AuthCodePurpose
  /// bcrypt hash. A leaked database dump must not hand out live codes.
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  /// Wrong guesses. The code is burned once this hits the attempt ceiling.
  attempts   Int             @default(0)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime        @default(now())

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}
