# Email. Required for one-time sign-in codes, password-reset codes and every
# other transactional email. Without one of the two options below those codes
# are never delivered and users cannot recover their accounts.
#
# The address mail is sent as. Must be an address the account below is allowed
# to send as -- on Gmail, the mailbox you authenticate with.
MAIL_FROM="Jnex Sales <sales@jnex.lk>"

# Option 1 (simplest): SMTP. No DNS setup required.
#   Brevo:  smtp-relay.brevo.com, port 587. Login and SMTP key come from the
#           dashboard under "SMTP & API"; MAIL_FROM must be an address verified
#           under "Senders".
#   Gmail:  smtp.gmail.com, port 587, your address as the user, and a Google
#           App Password (not your normal password) as the password.
# SMTP is used once host, user and password are all set; otherwise Resend is.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Option 2: Resend. Higher volume and better deliverability, but the sending
# domain has to be verified with DNS records before it will send.
RESEND_API_KEY=

# Cron
CRON_SECRET_KEY="your-cron-secret-key"

# AWS S3 (for product images)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET_NAME="jnex-images"
AWS_S3_REGION="eu-north-1"
